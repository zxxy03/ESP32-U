#include <WiFi.h>
#include <DNSServer.h>
#include <WebServer.h>

const byte DNS_PORT = 53;
IPAddress apIP(192, 168, 4, 1);
DNSServer dnsServer;
WebServer server(80);

const char* halamanPrank = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
  <meta name='viewport' content='width=device-width, initial-scale=1.0'>
  <title>Free WiFi Access</title>
  <style>
    body { 
      background-color: #ffc0cb; 
      font-family: Arial, sans-serif; 
      text-align: center; 
      height: 100vh; 
      margin: 0; 
      overflow: hidden; 
      display: flex; 
      flex-direction: column; 
      align-items: center; 
    }
    h1 { color: #d00000; font-size: 22px; margin-top: 20px; z-index: 1; }
    .img-container { margin-top: 20px; z-index: 1; }
    img { max-width: 180px; border-radius: 12px; box-shadow: 0 4px 8px rgba(0,0,0,0.2); }
    button { padding: 12px 24px; font-size: 16px; border-radius: 8px; border: none; cursor: pointer; position: absolute; z-index: 100; }
    #btnYa { background-color: #4CAF50; color: white; left: 35%; top: 75%; transform: translate(-50%, -50%); }
    #btnTidak { background-color: #f44336; color: white; left: 65%; top: 75%; transform: translate(-50%, -50%); transition: 0.1s; }
  </style>
</head>
<body>
  <h1>Zexy Ganteng gak?</h1>

  <button id='btnYa' onclick='pilihYa()'>Ganteng</button>
  <button id='btnTidak' onmouseover='lari()' onclick='lari()' ontouchstart='lari()'>Nggak</button>

  <script>
    function lari() {
      var btn = document.getElementById('btnTidak');
      var x = Math.random() * (window.innerWidth - 100);
      var y = (Math.random() * (window.innerHeight - 200)) + 150; 
      btn.style.left = x + 'px'; 
      btn.style.top = y + 'px';
    }
    
    function pilihYa() {
      //TEMPEL STRING BASE64 DI SINI (GAMBAR SETELAH DIPENCET)
      document.body.innerHTML = '<div style="padding-top:80px; text-align:center;">' +
        '<img src="data:image/jpeg;base64," style="max-width:220px; border-radius:12px;">' +
        '</div>';
    }
  </script>
</body>
</html>
)rawliteral";

void setup() {
  WiFi.mode(WIFI_AP);
  WiFi.softAPConfig(apIP, apIP, IPAddress(255, 255, 255, 0));
  WiFi.softAP("Free Wifi Lah"); 

  dnsServer.start(DNS_PORT, "*", apIP);

  server.onNotFound([]() {
    server.send(200, "text/html", halamanPrank);
  });

  server.begin();
}

void loop() {
  dnsServer.processNextRequest();
  server.handleClient();
}
